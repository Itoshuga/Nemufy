rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return hasVerifiedEmail() && request.auth.uid == userId;
    }

    function isAdmin() {
      return hasVerifiedEmail() && request.auth.token.admin == true;
    }

    function hasOnlyKeys(allowedKeys) {
      return request.resource.data.keys().hasOnly(allowedKeys);
    }

    function artistMembershipPath(artistId) {
      return /databases/$(database)/documents/artistMemberships/$(request.auth.uid + '_' + artistId);
    }

    function labelMembershipPath(labelId) {
      return /databases/$(database)/documents/labelMemberships/$(request.auth.uid + '_' + labelId);
    }

    function hasActiveArtistMembership(artistId) {
      return hasVerifiedEmail()
        && exists(artistMembershipPath(artistId))
        && get(artistMembershipPath(artistId)).data.status == 'active';
    }

    function hasActiveLabelMembership(labelId) {
      return hasVerifiedEmail()
        && exists(labelMembershipPath(labelId))
        && get(labelMembershipPath(labelId)).data.status == 'active';
    }

    function canManageArtistTeam(artistId) {
      return hasActiveArtistMembership(artistId)
        && get(artistMembershipPath(artistId)).data.permissions.manageTeam == true;
    }

    function canManageLabelTeam(labelId) {
      return hasActiveLabelMembership(labelId)
        && get(labelMembershipPath(labelId)).data.permissions.manageTeam == true;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if false;

      match /likedTracks/{trackId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hasOnlyKeys(['trackId', 'likedAt'])
          && request.resource.data.trackId == trackId
          && request.resource.data.likedAt is timestamp;
      }

      match /followedArtists/{artistId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hasOnlyKeys(['artistId', 'followedAt'])
          && request.resource.data.artistId == artistId
          && request.resource.data.followedAt is timestamp;
      }

      match /history/{historyId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && hasOnlyKeys(['trackId', 'playedAt', 'progressSeconds'])
          && request.resource.data.trackId is string
          && request.resource.data.playedAt is timestamp
          && request.resource.data.progressSeconds is number;
        allow update, delete: if false;
      }

      match /settings/preferences {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hasOnlyKeys(['theme', 'language', 'autoplay', 'updatedAt'])
          && request.resource.data.theme in ['dark']
          && request.resource.data.language in ['en', 'fr']
          && request.resource.data.autoplay is bool
          && request.resource.data.updatedAt is timestamp;
        allow delete: if false;
      }
    }

    match /usernames/{username} {
      allow read, write: if false;
    }

    match /artists/{artistId} {
      allow read: if hasVerifiedEmail();
      allow write: if false;
    }

    match /labels/{labelId} {
      allow read: if hasVerifiedEmail();
      allow write: if false;
    }

    match /releases/{releaseId} {
      allow read: if hasVerifiedEmail()
        && (resource.data.status == 'published' || isAdmin());
      allow write: if false;
    }

    match /tracks/{trackId} {
      allow read: if hasVerifiedEmail()
        && (resource.data.status == 'published' || isAdmin());
      allow write: if false;
    }

    match /playlists/{playlistId} {
      allow read: if hasVerifiedEmail()
        && (resource.data.visibility == 'public'
          || resource.data.creator.id == request.auth.uid
          || isAdmin());
      allow write: if false;
    }

    match /categories/{categoryId} {
      allow read: if hasVerifiedEmail();
      allow write: if false;
    }

    match /artistMemberships/{membershipId} {
      allow read: if hasVerifiedEmail()
        && (resource.data.userId == request.auth.uid
          || canManageArtistTeam(resource.data.artistId)
          || isAdmin());
      allow write: if false;
    }

    match /labelMemberships/{membershipId} {
      allow read: if hasVerifiedEmail()
        && (resource.data.userId == request.auth.uid
          || canManageLabelTeam(resource.data.labelId)
          || isAdmin());
      allow write: if false;
    }

    match /labelArtists/{relationId} {
      allow read: if hasVerifiedEmail()
        && (hasActiveLabelMembership(resource.data.labelId)
          || hasActiveArtistMembership(resource.data.artistId)
          || isAdmin());
      allow write: if false;
    }

    match /invitations/{invitationId} {
      allow read: if hasVerifiedEmail()
        && (resource.data.email == request.auth.token.email
          || (resource.data.type == 'artist' && canManageArtistTeam(resource.data.targetId))
          || (resource.data.type == 'label' && canManageLabelTeam(resource.data.targetId))
          || isAdmin());
      allow write: if false;
    }

    match /auditLogs/{auditLogId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
