    "eslint": "9.39.5",
    "eslint-config-next": "^16.3.6",
    "firebase-tools": "15.30.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5.9.0"
